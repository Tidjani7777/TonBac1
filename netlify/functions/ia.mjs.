// Fonction Netlify : relaie les questions vers Groq (offre gratuite) sans exposer la clé.
const LIMITE = 40;            // demandes par personne
const FENETRE = 10 * 60e3;    // sur 10 minutes
const vus = new Map();        // mémoire simple (non partagée entre instances)

export default async (req) => {
  if (req.method !== "POST") return new Response("Méthode non permise", { status: 405 });
  const cle = Netlify.env.get("GROQ_API_KEY");
  if (!cle) return new Response("Clé API absente", { status: 500 });

  const ip = req.headers.get("x-nf-client-connection-ip") || "inconnu";
  const maintenant = Date.now();
  const liste = (vus.get(ip) || []).filter((t) => maintenant - t < FENETRE);
  if (liste.length >= LIMITE) return new Response("Trop de demandes", { status: 429 });
  liste.push(maintenant);
  vus.set(ip, liste);

  let corps;
  try { corps = await req.json(); } catch { return new Response("Requête invalide", { status: 400 }); }
  const messages = (Array.isArray(corps.messages) ? corps.messages : [])
    .filter((m) => m && (m.role === "user" || m.role === "assistant") && typeof m.content === "string")
    .slice(-10)
    .map((m) => ({ role: m.role, content: m.content.slice(0, 9000) }));
  if (!messages.length || messages[messages.length - 1].role !== "user")
    return new Response("Requête invalide", { status: 400 });

  // Modèle léger pour le chat, modèle plus fort pour corriger les copies.
  const model = corps.tier === "complex" ? "openai/gpt-oss-120b" : "openai/gpt-oss-20b";
  const amont = await fetch("https://api.groq.com/openai/v1/chat/completions", {
    method: "POST",
    headers: { "content-type": "application/json", authorization: "Bearer " + cle },
    body: JSON.stringify({ model, messages, stream: true, reasoning_effort: "low", max_completion_tokens: 2500 }),
  });
  if (amont.status === 429) return new Response("Limite gratuite atteinte", { status: 429 });
  if (!amont.ok || !amont.body) return new Response("Erreur du service IA", { status: 502 });
  return new Response(amont.body, { headers: { "content-type": "text/event-stream", "cache-control": "no-store" } });
};

export const config = { path: "/api/ia" };
